# ===========================================
# FRONTEND - Variables de Entorno
# ===========================================

# API Backend URL
# En desarrollo: http://localhost:3000/api
# En producción: https://api.tu-dominio.com/api
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Application Configuration
# ===========================================
VITE_APP_NAME=E-commerce App
VITE_APP_VERSION=1.0.0

# ===========================================
# Feature Flags (opcional)
# ===========================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=true

# ===========================================
# Environment
# ===========================================
VITE_ENV=development

# ===========================================
# AWS CloudFront (para producción)
# ===========================================
# VITE_CDN_URL=https://d1234567890.cloudfront.net

# ===========================================
# Google Analytics (opcional)
# ===========================================
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# ===========================================
# Sentry (opcional para error tracking)
# ===========================================
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
